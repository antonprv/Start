		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>annotations</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<RootNamespace>Framework.Physics</RootNamespace>
		<AssemblyName>Physics.Integration</AssemblyName>
