<Project Sdk="Godot.NET.Sdk/4.7.0">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="addons\func_godot\**" />
    <Compile Remove="addons\script-ide\**" />
    <Compile Remove="Code\Shaders\**" />
    <EmbeddedResource Remove="addons\func_godot\**" />
    <EmbeddedResource Remove="addons\script-ide\**" />
    <EmbeddedResource Remove="Code\Shaders\**" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Code\Shaders\BaseShader.gdshader" />
    <None Include="Code\Shaders\WaterShader.gdshader" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Framework\Common\Framework.Common.csproj" />
    <ProjectReference Include="..\Framework\Components\Framework.Components.csproj" />
    <ProjectReference Include="..\Framework\DevConsole\Framework.Console.csproj" />
    <ProjectReference Include="..\Framework\FastMath\Framework.FastMath.csproj" />
    <ProjectReference Include="..\Framework\Logger\Framework.Logger.csproj" />
  </ItemGroup>
</Project>